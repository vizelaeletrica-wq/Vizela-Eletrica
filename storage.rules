rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Usado pelas telas Configurações > Série de Documentos e Templates de
    // Identificação (upload de ficheiros). Mesma condição de acesso do Firestore.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email_verified == true;
    }
  }
}
